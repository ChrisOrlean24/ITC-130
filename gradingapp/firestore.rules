rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /students/{studentId} {
      allow read, write: if request.time < timestamp.date(2027, 12, 31);

      match /{subcollection}/{docId} {
        allow read, write: if request.time < timestamp.date(2027, 12, 31);
      }
    }
  }
}
